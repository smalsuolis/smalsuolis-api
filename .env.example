NODE_ENV=local
PORT=3000

DB_CONNECTION=postgresql://postgres:postgres@localhost:5112/smalsuolis
CHROME_WS_ENDPOINT=ws://localhost:9321

AUTH_HOST=http://localhost:4444
AUTH_API_KEY=
AUTH_GROUP_ID=

POSTMARK_KEY=

REDIS_CONNECTION=redis://localhost:6112

JWT_SECRET=secret

SERVER_HOST="http://localhost:3000"
APP_HOST="https://smalsuolis.lt"

SENTRY_DSN=

# --- watchdog (Telegram alerting bot, run from ./watchdog) ---
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Password users must supply with `/subscribe <password>`.
TELEGRAM_SUBSCRIBE_PASSWORD=
# Where the watchdog polls. In docker-compose/VPS this points at the API container.
WATCHDOG_API_URL=http://localhost:3000
# Optional overrides (all ms, defaults shown):
# WATCHDOG_LIVENESS_INTERVAL_MS=150000         # 2.5 min between pings
# WATCHDOG_LIVENESS_FAILURES=2                  # alert after N consecutive failures
# WATCHDOG_LIVENESS_TIMEOUT_MS=10000            # per-ping HTTP timeout
# WATCHDOG_STALENESS_INTERVAL_MS=3600000        # 1h between staleness checks
# WATCHDOG_STALENESS_THRESHOLD_MS=604800000     # 7d = "stale"
# WATCHDOG_ALERT_COOLDOWN_MS=21600000           # 6h dedup window per alert key
# WATCHDOG_DB_PATH=./data/watchdog.db           # sqlite subscriber/state file
# WATCHDOG_TIMEZONE=Europe/Vilnius              # display timezone in alert messages
